generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
} 

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/* um modelo para guarda os dados hehe */
// ao mudar o nome da estrutura precisa sincronizar , usando : npx db push
model User { 
  id    String  @id @default(auto()) @map("_id") @db.ObjectId /* cria um id pro user automatico */
  email String  @unique /* diz que o email e unico , de fato */
  name  String /* nao tem '@unique' , porque obviamente nomes se repetem*/
  age   Int 
  
  /*caso tenha '?' quer dizer que e opcional coloca ou nao , os que nao tem '?' e obrigatorio */
 
} 