const { resolve } = require('node:path');
/* ferramenta do node para pegar o endereço das pasta de outra forma , 
por que se usarmos da forma tradicional quando subisse o projeto daria problema*/

module.exports = {
  config: resolve(__dirname, 'src', 'config', 'database.cjs'), /* config do banco */
  'migrations-path': resolve(__dirname, 'src', 'database', 'migrations'), /* manipulaçao das tabelas */
  'models-path': resolve(__dirname, 'src', 'app', 'models'), /* arquitetura mvc */
};
